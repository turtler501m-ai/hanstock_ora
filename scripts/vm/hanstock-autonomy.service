[Unit]
Description=Hanstock Continuous Autonomous Strategy Service
After=network-online.target hanstock.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hanstock
ExecStart=/home/ubuntu/hanstock/.venv/bin/python -m src.autonomy_service
Restart=on-failure
RestartSec=15
Environment=PATH=/home/ubuntu/hanstock/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AUTONOMY_RUNTIME_DIR=/home/ubuntu/hanstock/.runtime/autonomy
EnvironmentFile=/home/ubuntu/hanstock/.env
StandardOutput=append:/home/ubuntu/hanstock/logs/autonomy-service.log
StandardError=append:/home/ubuntu/hanstock/logs/autonomy-service.err.log

[Install]
WantedBy=multi-user.target
