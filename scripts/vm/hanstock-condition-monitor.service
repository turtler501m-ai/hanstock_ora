[Unit]
Description=Hanstock Intraday Condition Monitor
After=network-online.target hanstock.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hanstock
ExecStart=/home/ubuntu/hanstock/.venv/bin/python -m src.condition_monitor_service
Restart=on-failure
RestartSec=15
Environment=PATH=/home/ubuntu/hanstock/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/ubuntu/hanstock/.env
StandardOutput=append:/home/ubuntu/hanstock/logs/condition-monitor.log
StandardError=append:/home/ubuntu/hanstock/logs/condition-monitor.err.log

[Install]
WantedBy=multi-user.target
